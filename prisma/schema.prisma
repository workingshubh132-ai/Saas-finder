// VentureForge M1 Operating Kernel — data model.
//
// NOTE ON ENUMS: the SQLite connector does not support native Prisma
// `enum` types (`prisma validate` rejects them outright). Every
// enum-like column below is therefore a `String`, with the canonical
// set of allowed values defined once in TypeScript (src/domain/**) and
// enforced at every write path via Zod schemas (API boundary) and
// domain guard functions (service layer) — never by trusting the
// caller. See docs/DECISIONS.md for the full rationale and the
// migration path to Postgres native enums later.
//
// All JSON-shaped data (arrays, free-form metadata) is stored as a
// JSON-encoded `String` for the same reason: consistency with the
// enum approach and no dependence on connector-specific Json handling.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Agent Registry
// ---------------------------------------------------------------------------

model Agent {
  id          String @id @default(cuid())
  name        String
  role        String
  department  String
  description String
  status      String @default("ACTIVE")

  /// JSON-encoded string[] of descriptive capability tags (tools available).
  /// NOT authorization — see AgentPermission for explicit grants.
  capabilities String @default("[]")

  modelProvider String? @map("model_provider")
  modelName     String? @map("model_name")

  parentAgentId String? @map("parent_agent_id")
  parent        Agent?  @relation("AgentHierarchy", fields: [parentAgentId], references: [id], onDelete: SetNull)
  children      Agent[] @relation("AgentHierarchy")

  /// Ceiling autonomy level this agent may ever operate at (GREEN/YELLOW/ORANGE/RED).
  riskLevel String @map("risk_level")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  permissions       AgentPermission[]
  tasks             Task[]            @relation("AssignedTasks")
  approvalRequests  ApprovalRequest[]
  evidenceCollected Evidence[]
  signalsCollected  Signal[]
  identities        Identity[]
  executions        AgentExecution[]

  /// M5 — docs/M5_ARCHITECTURE_PROPOSAL.md §22.
  icpProfilesGenerated      IcpProfile[]
  prospectsDiscovered       Prospect[]
  outreachMessagesDrafted   OutreachMessage[]
  customerEvidenceExtracted CustomerEvidence[]

  /// M6 — docs/M6_ARCHITECTURE_PROPOSAL.md §34.
  productSpecsGenerated     ProductSpec[]
  mvpArchitecturesGenerated MvpArchitecture[]
  engineeringTasksAssigned  EngineeringTask[]
  codeReviewsPerformed      CodeReview[]
  qaReportsPerformed        QaReport[]
  securityReviewsPerformed  SecurityReview[]

  @@index([status])
  @@index([department])
  @@map("agents")
}

model AgentPermission {
  id String @id @default(cuid())

  agentId String @map("agent_id")
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// One of the Permission values (see src/domain/permission).
  permission String

  grantedBy String    @map("granted_by")
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedBy String?   @map("revoked_by")
  revokedAt DateTime? @map("revoked_at")
  reason    String?

  @@index([agentId, permission])
  @@map("agent_permissions")
}

// ---------------------------------------------------------------------------
// Task Engine
// ---------------------------------------------------------------------------

model Task {
  id        String @id @default(cuid())
  title     String
  objective String

  assignedAgentId String? @map("assigned_agent_id")
  assignedAgent   Agent?  @relation("AssignedTasks", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  parentTaskId String? @map("parent_task_id")
  parentTask   Task?   @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks     Task[]  @relation("TaskHierarchy")

  status    String @default("PENDING")
  priority  String @default("NORMAL")
  riskLevel String @map("risk_level")

  /// JSON-encoded structured input/output; free text for error.
  input  String?
  output String?
  error  String?

  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  executions AgentExecution[]

  @@index([status])
  @@index([assignedAgentId])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Approval Engine (Human Decision Queue backing store)
// ---------------------------------------------------------------------------

model ApprovalRequest {
  id String @id @default(cuid())

  requestedByAgentId String @map("requested_by_agent_id")
  requestedByAgent   Agent  @relation(fields: [requestedByAgentId], references: [id], onDelete: Restrict)

  action      String
  description String
  riskLevel   String @map("risk_level")

  /// What this approval request is about, so the queue can link back to
  /// the resource under review (e.g. "OPPORTUNITY" / opportunity id).
  /// Not in the Constitution's literal field list; added because the
  /// vertical slice and decision-queue traceability requirement (M1 §11,
  /// §28) are impossible without it. See docs/DECISIONS.md.
  resourceType String? @map("resource_type")
  resourceId   String? @map("resource_id")

  /// JSON-encoded string[] of Evidence ids backing this request.
  evidence String?
  reason   String?

  status String @default("PENDING")

  reviewedBy     String?   @map("reviewed_by")
  reviewedAt     DateTime? @map("reviewed_at")
  decisionReason String?   @map("decision_reason")

  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  /// M4 — docs/M4_ARCHITECTURE_PROPOSAL.md §20.
  decisionRecords DecisionRecord[]

  /// M5 — docs/M5_ARCHITECTURE_PROPOSAL.md §13. One ApprovalRequest ever binds to one OutreachMessage (resourceType="OUTREACH_MESSAGE").
  outreachMessages OutreachMessage[]

  @@index([status])
  @@index([resourceType, resourceId])
  @@map("approval_requests")
}

// ---------------------------------------------------------------------------
// Evidence Engine
// ---------------------------------------------------------------------------

model Evidence {
  id String @id @default(cuid())

  claim           String
  source          String
  sourceType      String  @map("source_type")
  sourceReference String? @map("source_reference")

  collectedByAgentId String   @map("collected_by_agent_id")
  collectedByAgent   Agent    @relation(fields: [collectedByAgentId], references: [id], onDelete: Restrict)
  collectedAt        DateTime @default(now()) @map("collected_at")

  /// M3 — set when this Evidence was formalized from a Signal
  /// (docs/M3_ARCHITECTURE_PROPOSAL.md §8). Null for evidence collected
  /// through the M1/M2 manual/direct paths, which stay valid.
  signalId String? @map("signal_id")
  signal   Signal? @relation(fields: [signalId], references: [id], onDelete: SetNull)

  /// Trustworthiness of the source (LOW/MEDIUM/HIGH).
  reliability String
  /// Collector's confidence that the claim is true, 0..1.
  confidence  Float

  verificationStatus String @default("UNVERIFIED") @map("verification_status")

  /// JSON-encoded free-form metadata.
  metadata String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  opportunityLinks        OpportunityEvidence[]
  resolvedGaps            EvidenceGap[]
  /// M4 — docs/M4_ARCHITECTURE_PROPOSAL.md §4.
  claimLinks              ClaimEvidence[]
  /// M5 — docs/M5_ARCHITECTURE_PROPOSAL.md §16. Set when sourceType="CUSTOMER" and this row was produced by the Response Analyst.
  customerEvidenceWrapper CustomerEvidence[]

  @@index([collectedByAgentId])
  @@index([sourceType])
  @@index([signalId])
  @@map("evidence")
}

// ---------------------------------------------------------------------------
// Opportunity Engine
// ---------------------------------------------------------------------------

model Opportunity {
  id String @id @default(cuid())

  title          String
  problem        String
  targetCustomer String @map("target_customer")
  description    String

  status String @default("DISCOVERED")

  opportunityScore Float? @map("opportunity_score")
  confidenceScore  Float? @map("confidence_score")

  validationLevel String @default("LEVEL_0") @map("validation_level")

  /// M3 — traceability root: which Problem this candidate was
  /// generated from (docs/M3_ARCHITECTURE_PROPOSAL.md §9). Null for
  /// opportunities created through the M1/M2 manual/direct paths.
  problemId     String?  @map("problem_id")
  sourceProblem Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)

  /// M3 — denormalized for cheap reads; recomputed whenever
  /// evidenceGapService.analyze() runs (docs/M3_ARCHITECTURE_PROPOSAL.md §14).
  nextBestResearchQuestion String? @map("next_best_research_question")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// JSON-encoded free-form metadata.
  metadata String?

  evidenceLinks      OpportunityEvidence[]
  scoreRecords       OpportunityScoreRecord[]
  chairmanReviews    ChairmanReview[]
  evidenceGaps       EvidenceGap[]
  researchQueueItems ResearchQueueItem[]

  /// M4 — docs/M4_ARCHITECTURE_PROPOSAL.md §21.
  claims             Claim[]
  ceoRecommendations CeoRecommendation[]
  investmentMemos    InvestmentMemo[]
  decisionRecords    DecisionRecord[]
  decisionCycles     DecisionCycle[]

  /// M5 — docs/M5_ARCHITECTURE_PROPOSAL.md §22.
  icpProfiles            IcpProfile[]
  prospects              Prospect[]
  outreachExperiments    OutreachExperiment[]
  customerDiscoveryMemos CustomerDiscoveryMemo[]

  /// M6 — docs/M6_ARCHITECTURE_PROPOSAL.md §34. One row per build attempt (§3).
  products Product[]

  @@index([status])
  @@index([problemId])
  @@map("opportunities")
}

model OpportunityEvidence {
  id String @id @default(cuid())

  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  evidenceId String   @map("evidence_id")
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([opportunityId, evidenceId])
  @@map("opportunity_evidence")
}

/// Historical record of each time an Opportunity was scored, so a
/// re-score never destroys the trail behind an earlier decision.
model OpportunityScoreRecord {
  id String @id @default(cuid())

  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  /// JSON-encoded per-dimension inputs (pain, demand, willingnessToPay, ...).
  dimensions String

  opportunityScore Float  @map("opportunity_score")
  confidenceScore  Float  @map("confidence_score")
  scoredBy         String @map("scored_by")

  /// M3 — a THIRD, independent axis alongside score/confidence, never
  /// conflated with either (Constitution §12; M3 brief Part 21-22;
  /// docs/M3_ARCHITECTURE_PROPOSAL.md §11). Nullable: pre-M3 score
  /// records, and any scoring path that hasn't run kill-risk analysis,
  /// simply have none yet — never defaulted to a fabricated 0.
  killRiskScore      Float?  @map("kill_risk_score")
  /// JSON-encoded per-dimension kill-risk inputs (see kill-risk-scorer.ts).
  killRiskDimensions String? @map("kill_risk_dimensions")
  /// JSON-encoded string[] — every dimension that crossed the "high risk" threshold, explained.
  killRiskReasons    String? @map("kill_risk_reasons")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([opportunityId])
  @@map("opportunity_score_records")
}

// ---------------------------------------------------------------------------
// Memory Foundation
// ---------------------------------------------------------------------------

model Memory {
  id String @id @default(cuid())

  type    String
  subject String
  content String

  source     String?
  confidence Float?

  createdAt DateTime @default(now()) @map("created_at")

  /// JSON-encoded free-form metadata.
  metadata String?

  @@index([type, subject])
  @@map("memories")
}

// ---------------------------------------------------------------------------
// Event Log (in-process outbox)
// ---------------------------------------------------------------------------

model Event {
  id String @id @default(cuid())

  type String

  /// JSON-encoded payload — enough to reconstruct what happened.
  payload String

  occurredAt DateTime @default(now()) @map("occurred_at")

  @@index([type])
  @@map("events")
}

// ---------------------------------------------------------------------------
// Audit Log — append-only from the application layer (no update/delete
// repository methods are exposed; see src/db/repositories/audit.repository.ts)
// ---------------------------------------------------------------------------

model AuditLog {
  id String @id @default(cuid())

  actorType String  @map("actor_type")
  actorId   String? @map("actor_id")

  action       String
  resourceType String  @map("resource_type")
  resourceId   String? @map("resource_id")

  riskLevel String? @map("risk_level")
  result    String
  reason    String?

  /// JSON-encoded free-form metadata.
  metadata String?

  timestamp DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// M2 — Authenticated Actor Identity
// (docs/M2_ARCHITECTURE_PROPOSAL.md §6)
// ---------------------------------------------------------------------------

model Identity {
  id String @id @default(cuid())

  /// HUMAN | AGENT | SYSTEM
  type  String
  label String

  /// Only set for type = AGENT.
  agentId String? @map("agent_id")
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// SHA-256 of the bearer token. The plaintext token is shown to the
  /// caller exactly once, at creation, and never stored.
  tokenHash   String @unique @map("token_hash")
  tokenPrefix String @map("token_prefix")

  status String @default("ACTIVE")

  createdByIdentityId String?   @map("created_by_identity_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  revokedAt           DateTime? @map("revoked_at")
  expiresAt           DateTime? @map("expires_at")
  lastUsedAt          DateTime? @map("last_used_at")

  executionsStarted          AgentExecution[]
  researchCyclesStarted      ResearchCycle[]
  /// M4 — docs/M4_ARCHITECTURE_PROPOSAL.md §21.
  decisionCyclesStarted      DecisionCycle[]
  /// M5 — docs/M5_ARCHITECTURE_PROPOSAL.md §22.
  outreachExperimentsCreated OutreachExperiment[]
  customerResponsesEntered   CustomerResponse[]
  /// M6 — docs/M6_ARCHITECTURE_PROPOSAL.md §34.
  productsCreated            Product[]

  @@index([agentId])
  @@index([status])
  @@map("identities")
}

// ---------------------------------------------------------------------------
// M2 — Agent Runtime (docs/M2_ARCHITECTURE_PROPOSAL.md §5, §10, §12)
// ---------------------------------------------------------------------------

model AgentExecution {
  id String @id @default(cuid())

  agentId String @map("agent_id")
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Restrict)

  taskId String? @map("task_id")
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  /// M3 — set when this execution ran as a step inside a bounded
  /// ResearchCycle rather than a standalone POST /api/research call
  /// (docs/M3_ARCHITECTURE_PROPOSAL.md §22).
  researchCycleId String?        @map("research_cycle_id")
  researchCycle   ResearchCycle? @relation(fields: [researchCycleId], references: [id], onDelete: SetNull)

  /// M4 — set when this execution ran as a step inside a bounded
  /// DecisionCycle (docs/M4_ARCHITECTURE_PROPOSAL.md §21), mirroring
  /// researchCycleId exactly.
  decisionCycleId String?        @map("decision_cycle_id")
  decisionCycle   DecisionCycle? @relation(fields: [decisionCycleId], references: [id], onDelete: SetNull)

  status String @default("CREATED")

  startedByIdentityId String   @map("started_by_identity_id")
  startedByIdentity   Identity @relation(fields: [startedByIdentityId], references: [id], onDelete: Restrict)

  modelProvider String? @map("model_provider")
  modelName     String? @map("model_name")

  stepCount      Int @default(0) @map("step_count")
  toolCallCount  Int @default(0) @map("tool_call_count")
  modelCallCount Int @default(0) @map("model_call_count")
  retryCount     Int @default(0) @map("retry_count")

  promptTokens     Int?   @map("prompt_tokens")
  completionTokens Int?   @map("completion_tokens")
  estimatedCostUsd Float? @map("estimated_cost_usd")

  /// JSON-encoded execution input (objective, etc.).
  input     String
  /// JSON-encoded structured result once COMPLETED.
  output    String?
  error     String?
  errorCode String? @map("error_code")

  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  toolExecutions ToolExecution[]

  @@index([status])
  @@index([agentId])
  @@index([taskId])
  @@index([decisionCycleId])
  @@map("agent_executions")
}

model ToolExecution {
  id String @id @default(cuid())

  executionId String         @map("execution_id")
  execution   AgentExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  toolId String @map("tool_id")
  status String

  /// JSON-encoded tool input/output.
  input  String
  output String?
  error  String?

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  durationMs  Int?      @map("duration_ms")

  @@index([executionId])
  @@index([toolId])
  @@map("tool_executions")
}

// ---------------------------------------------------------------------------
// M2 — Chairman (docs/M2_ARCHITECTURE_PROPOSAL.md §7)
// ---------------------------------------------------------------------------

model ChairmanReview {
  id String @id @default(cuid())

  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  decision String

  reasoning       String
  /// JSON-encoded string[] — the adversarial objections raised (M2 brief Part 16).
  objections      String
  /// JSON-encoded string[].
  missingEvidence String @map("missing_evidence")
  confidence      Float
  recommendation  String

  modelProvider String @map("model_provider")
  modelName     String @map("model_name")

  createdAt DateTime @default(now()) @map("created_at")

  /// M4 — docs/M4_ARCHITECTURE_PROPOSAL.md §17, §20.
  investmentMemos        InvestmentMemo[]
  decisionRecords        DecisionRecord[]
  /// M5 — docs/M5_ARCHITECTURE_PROPOSAL.md §21-22.
  customerDiscoveryMemos CustomerDiscoveryMemo[]
  /// M6 — docs/M6_ARCHITECTURE_PROPOSAL.md §33-34.
  productReviewMemos     ProductReviewMemo[]

  @@index([opportunityId])
  @@map("chairman_reviews")
}

// ---------------------------------------------------------------------------
// M3 — Opportunity Intelligence Engine
// (docs/M3_ARCHITECTURE_PROPOSAL.md)
// ---------------------------------------------------------------------------

/// The raw, low-commitment record of "something a source returned" —
/// distinct from Evidence (§2, §8). A Signal only becomes Evidence
/// once it's actually used to back a specific Problem/Opportunity claim.
model Signal {
  id String @id @default(cuid())

  /// ResearchSource id (e.g. "hacker_news", "stack_exchange").
  source          String
  /// Shares Evidence's own sourceType vocabulary — see domain/signal/signal.types.ts.
  sourceType      String @map("source_type")
  sourceReference String @map("source_reference")

  title   String
  content String

  /// Which agent's tool call collected this signal (Constitution §25 —
  /// every significant agent action must be attributable). Mirrors
  /// Evidence.collectedByAgentId exactly.
  collectedByAgentId String @map("collected_by_agent_id")
  collectedByAgent   Agent  @relation(fields: [collectedByAgentId], references: [id], onDelete: Restrict)

  publishedAt   DateTime? @map("published_at")
  collectedAt   DateTime  @default(now()) @map("collected_at")
  /// Opaque source-specific author label (e.g. a username) — never
  /// resolved to a real-world identity.
  authorContext String?   @map("author_context")
  language      String    @default("en")

  /// sha256(title + content) — the exact-duplicate key (§5).
  contentHash    String  @map("content_hash")
  /// Adapter-computed key identifying "same thread/post/author
  /// context" so independent-source counting is a real query, not a
  /// narrative claim (§2, §6, Part 13).
  sourceGroupKey String? @map("source_group_key")

  /// JSON-encoded source-specific extras (points, tags, answer count...).
  metadata String?

  /// Seeded from source-reliability-policy.ts; may be refined once
  /// promoted to Evidence.
  reliability  String
  /// Deterministic 0..1 quality assessment (§10) — specificity,
  /// recency, originality; never a model call.
  qualityScore Float  @default(0) @map("quality_score")

  status String @default("NEW")

  clusterId String?        @map("cluster_id")
  cluster   SignalCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)

  duplicateOfSignalId String?  @map("duplicate_of_signal_id")
  duplicateOfSignal   Signal?  @relation("SignalDuplicates", fields: [duplicateOfSignalId], references: [id], onDelete: SetNull)
  duplicatesOfThis    Signal[] @relation("SignalDuplicates")
  /// Human-readable explanation of why this was marked a duplicate —
  /// every dedup decision must be explainable (Part 9).
  duplicateReason     String?  @map("duplicate_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  evidence Evidence[]

  @@index([status])
  @@index([source])
  @@index([contentHash])
  @@index([sourceGroupKey])
  @@index([clusterId])
  @@index([collectedByAgentId])
  @@map("signals")
}

/// Groups related signals about a common underlying problem/theme (§6).
model SignalCluster {
  id String @id @default(cuid())

  name    String
  summary String

  signalCount            Int   @default(0) @map("signal_count")
  /// COUNT(DISTINCT sourceGroupKey) across non-duplicate member
  /// signals — never conflated with signalCount (Part 13: "100 posts
  /// != 100 independent customers").
  independentSourceCount Int   @default(0) @map("independent_source_count")
  confidence             Float @default(0)

  status String @default("ACTIVE")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  signals  Signal[]
  problems Problem[]

  @@index([status])
  @@map("signal_clusters")
}

/// A structured, extracted recurring problem — the M3 brief's literal
/// field list (Part 11). Distinguishes "I don't like this product"
/// from "a recurring, expensive workflow problem affecting many
/// customers" (§7).
model Problem {
  id String @id @default(cuid())

  clusterId String        @map("cluster_id")
  cluster   SignalCluster @relation(fields: [clusterId], references: [id], onDelete: Restrict)

  statement              String
  customerSegment        String @map("customer_segment")
  workflow               String
  pain                   String
  frequency              String
  currentSolution        String @map("current_solution")
  dissatisfaction        String
  urgency                String
  willingnessToPaySignal String @map("willingness_to_pay_signal")

  /// Clamped by the service to the cluster's real, non-duplicate
  /// signal count — never trusted directly from model output (§7).
  evidenceCount Int   @map("evidence_count")
  confidence    Float

  status String @default("CANDIDATE")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  opportunities          Opportunity[]
  competitorObservations CompetitorObservation[]

  @@index([status])
  @@index([clusterId])
  @@map("problems")
}

/// A canonical competitor record, reusable across opportunities/problems.
model Competitor {
  id String @id @default(cuid())

  name        String
  url         String?
  description String?

  createdAt DateTime @default(now()) @map("created_at")

  observations CompetitorObservation[]

  @@map("competitors")
}

/// One timestamped, opportunity-specific note about a competitor —
/// pricing/positioning/reviews/strengths/weaknesses as actually found
/// by the Competitor Analyst, never fabricated (Part 17).
model CompetitorObservation {
  id String @id @default(cuid())

  competitorId String     @map("competitor_id")
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Restrict)

  problemId String  @map("problem_id")
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  type   String
  detail String

  sourceReference String? @map("source_reference")

  observedAt DateTime @default(now()) @map("observed_at")

  @@index([competitorId])
  @@index([problemId])
  @@map("competitor_observations")
}

/// A known unknown/assumption about an Opportunity, and the single
/// question that would resolve it (Part 31 — the evidence-gap engine).
model EvidenceGap {
  id String @id @default(cuid())

  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  /// Free label (e.g. "willingness_to_pay") — see domain/evidence-gap/evidence-gap.types.ts.
  dimension   String
  status      String @default("UNKNOWN")
  description String

  suggestedResearchQuestion String @map("suggested_research_question")
  /// Deterministic ranking input: how much resolving this gap would
  /// matter (weight in the score) x how unresolved it currently is.
  /// M4 — when claimId is set, computed via the claim-aware Expected
  /// Information Gain formula instead (domain/claim/eig.ts;
  /// docs/M4_ARCHITECTURE_PROPOSAL.md §15).
  impactScore               Float  @map("impact_score")

  /// M4 — set when this gap is about a specific Claim rather than a
  /// bare scoring dimension (docs/M4_ARCHITECTURE_PROPOSAL.md §15).
  /// Null keeps the original M3 dimension-level gap path unchanged.
  claimId String? @map("claim_id")
  claim   Claim?  @relation(fields: [claimId], references: [id], onDelete: SetNull)

  resolvedAt           DateTime? @map("resolved_at")
  resolvedByEvidenceId String?   @map("resolved_by_evidence_id")
  resolvedByEvidence   Evidence? @relation(fields: [resolvedByEvidenceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  queueItems ResearchQueueItem[]

  @@index([opportunityId])
  @@index([status])
  @@index([claimId])
  @@map("evidence_gaps")
}

/// A bounded, budgeted unit of orchestrated research work — the same
/// entity carries both "research cycle" (Part 28) and "operating
/// window" (Part 29) lifecycles (§16).
model ResearchCycle {
  id String @id @default(cuid())

  objective String
  status    String @default("SCHEDULED")

  startedByIdentityId String   @map("started_by_identity_id")
  startedByIdentity   Identity @relation(fields: [startedByIdentityId], references: [id], onDelete: Restrict)

  maxDurationMs Int   @map("max_duration_ms")
  maxSignals    Int   @map("max_signals")
  maxToolCalls  Int   @map("max_tool_calls")
  maxModelCalls Int   @map("max_model_calls")
  maxCostUsd    Float @map("max_cost_usd")

  signalsCollected       Int    @default(0) @map("signals_collected")
  toolCallCount          Int    @default(0) @map("tool_call_count")
  modelCallCount         Int    @default(0) @map("model_call_count")
  opportunitiesGenerated Int    @default(0) @map("opportunities_generated")
  estimatedCostUsd       Float? @map("estimated_cost_usd")

  /// Set when status = STOPPED: which budget was exhausted (Part 38).
  stoppedReason String? @map("stopped_reason")

  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  executions AgentExecution[]

  @@index([status])
  @@map("research_cycles")
}

/// The prioritized research queue (Part 30) — what should a cycle work
/// on next, which is not always "the highest-scoring opportunity."
model ResearchQueueItem {
  id String @id @default(cuid())

  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  evidenceGapId String?      @map("evidence_gap_id")
  evidenceGap   EvidenceGap? @relation(fields: [evidenceGapId], references: [id], onDelete: SetNull)

  kind          String
  /// Documented weighted formula — see research-queue.service.ts.
  priorityScore Float  @map("priority_score")
  reason        String
  status        String @default("PENDING")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([opportunityId])
  @@map("research_queue_items")
}

// ---------------------------------------------------------------------------
// M4 — Decision Intelligence Engine
// (docs/M4_ARCHITECTURE_PROPOSAL.md)
// ---------------------------------------------------------------------------

/// The falsifiable unit of assertion underneath an Opportunity's
/// dimension-level scores (docs/M4_ARCHITECTURE_PROPOSAL.md §3) —
/// exactly twelve claimTypes (domain/claim/claim.types.ts), each
/// traceable to a field VentureForge already computed.
model Claim {
  id String @id @default(cuid())

  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  /// One of CLAIM_TYPES.
  claimType String @map("claim_type")
  statement String

  /// CRITICAL|HIGH|MEDIUM|LOW — assigned deterministically from claimType.
  importance String

  /// One of CLAIM_VALIDATION_STATUSES (domain/claim/claim-validation.types.ts).
  status String @default("UNVERIFIED")

  /// Deterministically recalculated (§11) — never a raw model number.
  confidence Float @default(0)

  /// Free label naming which real field this claim was extracted from
  /// (e.g. "PROBLEM.willingnessToPaySignal") — traceability against
  /// Part 44's "never fabricate" requirement.
  extractedFrom String? @map("extracted_from")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  claimEvidence     ClaimEvidence[]
  validationReports ValidationReport[]
  evidenceGaps      EvidenceGap[]

  /// M5 — docs/M5_ARCHITECTURE_PROPOSAL.md §11-12. Which claim an experiment/message is actually testing.
  outreachExperiments OutreachExperiment[]
  outreachMessages    OutreachMessage[]

  /// M6 — docs/M6_ARCHITECTURE_PROPOSAL.md §34. Which claim a proposed feature tests (§6).
  features Feature[]

  @@index([opportunityId])
  @@index([status])
  @@map("claims")
}

/// The Claim<->Evidence relationship (§4) — a genuine relation, not
/// metadata. Deliberately append-only, not unique on (claimId,
/// evidenceId): each ValidationReport run creates fresh rows rather
/// than upserting an earlier classification, so contradicting evidence
/// already found is never erased by a later, more favorable read (§6).
model ClaimEvidence {
  id String @id @default(cuid())

  claimId String @map("claim_id")
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  evidenceId String   @map("evidence_id")
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  /// SUPPORTING|CONTRADICTING|UNKNOWN (domain/claim/claim-evidence.types.ts).
  relationship String
  reasoning    String

  validationReportId String?           @map("validation_report_id")
  validationReport   ValidationReport? @relation(fields: [validationReportId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([claimId])
  @@index([evidenceId])
  @@map("claim_evidence")
}

/// The Evidence Validator's structured, adversarial output for one
/// Claim (§2, §15) — Zod/domain-validated, never raw model output
/// trusted directly. Append-only: a re-validation is always a new row.
model ValidationReport {
  id String @id @default(cuid())

  claimId String @map("claim_id")
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Restrict)

  /// One of CLAIM_VALIDATION_STATUSES — this run's conclusion.
  status     String
  /// The Validator's own confidence in ITS assessment — distinct from
  /// Claim.confidence, the separate deterministic value this report
  /// feeds into the confidence-recalculation formula (§11).
  confidence Float

  /// JSON-encoded string[] of Evidence ids.
  supportingEvidenceIds    String @map("supporting_evidence_ids")
  contradictingEvidenceIds String @map("contradicting_evidence_ids")

  /// JSON-encoded IndependenceAssessment ({level, reasoning}).
  independenceAssessment String @map("independence_assessment")
  /// JSON-encoded EvidenceQualityAssessment (all 7 factors + aggregate) — never collapsed to one number (§8).
  qualityAssessment      String @map("quality_assessment")

  reasoning           String
  /// JSON-encoded string[] — what evidence is still missing.
  missingEvidence     String @map("missing_evidence")
  /// The single next research question this report recommends — feeds EIG/evidence-gap (§15).
  recommendedResearch String @map("recommended_research")

  modelProvider String @map("model_provider")
  modelName     String @map("model_name")

  createdAt DateTime @default(now()) @map("created_at")

  claimEvidence ClaimEvidence[]

  @@index([claimId])
  @@map("validation_reports")
}

/// The CEO's structured, historized recommendation for one Opportunity
/// (§12) — append-only, mirroring ChairmanReview/OpportunityScoreRecord
/// exactly (§27). Every recommendation cites specific claim/report ids
/// — never "KILL - score 42" with no reasoning.
model CeoRecommendation {
  id String @id @default(cuid())

  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  decisionCycleId String?        @map("decision_cycle_id")
  decisionCycle   DecisionCycle? @relation(fields: [decisionCycleId], references: [id], onDelete: SetNull)

  /// One of CEO_DECISION_ACTIONS (domain/decision/decision-action.types.ts) — exactly six, no more.
  action    String
  reasoning String

  /// JSON-encoded string[].
  citedClaimIds            String @map("cited_claim_ids")
  citedValidationReportIds String @map("cited_validation_report_ids")

  confidence    Float
  priorityScore Float @map("priority_score")

  createdAt DateTime @default(now()) @map("created_at")

  investmentMemos        InvestmentMemo[]
  decisionRecords        DecisionRecord[]
  /// M5 — docs/M5_ARCHITECTURE_PROPOSAL.md §20, §22.
  customerDiscoveryMemos CustomerDiscoveryMemo[]
  /// M6 — docs/M6_ARCHITECTURE_PROPOSAL.md §32, §34.
  productReviewMemos     ProductReviewMemo[]

  @@index([opportunityId])
  @@map("ceo_recommendations")
}

/// The Human Owner's actual final artifact (§17) — compiled
/// deterministically from already-persisted data, zero new model
/// calls. Append-only: a re-run after new evidence is a new row, never
/// an edit, so it stays clear which memo a given human decision was
/// actually made against (§27).
model InvestmentMemo {
  id String @id @default(cuid())

  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  ceoRecommendationId String            @map("ceo_recommendation_id")
  ceoRecommendation   CeoRecommendation @relation(fields: [ceoRecommendationId], references: [id], onDelete: Restrict)

  chairmanReviewId String         @map("chairman_review_id")
  chairmanReview   ChairmanReview @relation(fields: [chairmanReviewId], references: [id], onDelete: Restrict)

  /// JSON-encoded full structured memo body (every brief-named section).
  content String

  /// MANDATORY, own column (never buried in content JSON): the
  /// Chairman's own top-ranked objection — never generic.
  strongestArgumentAgainst String @map("strongest_argument_against")
  /// MANDATORY, own column: the CEO's own evidence-grounded reasoning.
  investmentThesis         String @map("investment_thesis")

  recommendation String
  confidence     Float
  keyReason      String @map("key_reason")
  biggestRisk    String @map("biggest_risk")
  nextAction     String @map("next_action")

  createdAt DateTime @default(now()) @map("created_at")

  decisionRecords DecisionRecord[]

  @@index([opportunityId])
  @@map("investment_memos")
}

/// The final, immutable snapshot of one human decision (§20, §27) —
/// fires OPPORTUNITY_DECISION_RECORDED. Denormalizes rejected/accepted
/// claim ids directly (not just reachable via joins) so future
/// calibration queries (Part 39) don't need to join through three
/// tables.
model DecisionRecord {
  id String @id @default(cuid())

  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  approvalRequestId String          @map("approval_request_id")
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)

  investmentMemoId String?         @map("investment_memo_id")
  investmentMemo   InvestmentMemo? @relation(fields: [investmentMemoId], references: [id], onDelete: SetNull)

  ceoRecommendationId String?            @map("ceo_recommendation_id")
  ceoRecommendation   CeoRecommendation? @relation(fields: [ceoRecommendationId], references: [id], onDelete: SetNull)

  chairmanReviewId String?         @map("chairman_review_id")
  chairmanReview   ChairmanReview? @relation(fields: [chairmanReviewId], references: [id], onDelete: SetNull)

  /// Mirrors ApprovalRequest.status at decision time (APPROVED/REJECTED/DEFERRED).
  humanDecision String  @map("human_decision")
  humanReason   String? @map("human_reason")

  opportunityScoreAtDecision Float? @map("opportunity_score_at_decision")
  confidenceAtDecision       Float? @map("confidence_at_decision")
  killRiskAtDecision         Float? @map("kill_risk_at_decision")

  /// JSON-encoded string[] — structured feedback for future calibration (Part 38/39), never auto-retraining.
  rejectedClaimIds     String @map("rejected_claim_ids")
  acceptedClaimIds     String @map("accepted_claim_ids")
  missingEvidenceNoted String @map("missing_evidence_noted")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([opportunityId])
  @@map("decision_records")
}

/// The CEO-pipeline sibling of ResearchCycle (§16, §21, §25) —
/// entry-pointed on an existing opportunityId rather than a cold-start
/// objective. Same bounded/budgeted/audited shape, sharing the
/// identical status lifecycle (domain/shared/cycle-lifecycle.ts).
model DecisionCycle {
  id String @id @default(cuid())

  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  status String @default("SCHEDULED")

  startedByIdentityId String   @map("started_by_identity_id")
  startedByIdentity   Identity @relation(fields: [startedByIdentityId], references: [id], onDelete: Restrict)

  maxClaims            Int @map("max_claims")
  maxValidatorSearches Int @map("max_validator_searches")
  maxModelCalls        Int @map("max_model_calls")
  maxResearchTasks     Int @map("max_research_tasks")
  maxCeoPlanningSteps  Int @map("max_ceo_planning_steps")
  maxDurationMs        Int @map("max_duration_ms")

  claimsValidated      Int @default(0) @map("claims_validated")
  validatorSearchCount Int @default(0) @map("validator_search_count")
  modelCallCount       Int @default(0) @map("model_call_count")
  researchTasksCreated Int @default(0) @map("research_tasks_created")
  ceoPlanningSteps     Int @default(0) @map("ceo_planning_steps")

  /// Set when status = STOPPED: which budget was exhausted (§25).
  stoppedReason String? @map("stopped_reason")

  createdAt   DateTime  @default(now()) @map("created_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  ceoRecommendations CeoRecommendation[]
  executions         AgentExecution[]

  @@index([status])
  @@index([opportunityId])
  @@map("decision_cycles")
}

// ---------------------------------------------------------------------------
// M5 — Customer Discovery Intelligence
// (docs/M5_ARCHITECTURE_PROPOSAL.md)
// ---------------------------------------------------------------------------

/// Who VentureForge believes should be talked to, derived from an
/// opportunity's own Claims/Evidence (§3) — historized like
/// OpportunityScoreRecord, never overwritten: a refined ICP is a new
/// row, so which targeting decision a given batch of Prospects was
/// discovered under always stays a real, queryable fact.
model IcpProfile {
  id String @id @default(cuid())

  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  industry        String
  companySizeMin  Int?   @map("company_size_min")
  companySizeMax  Int?   @map("company_size_max")
  role            String
  problemExposure String @map("problem_exposure")
  likelyFrequency String @map("likely_frequency")
  geography       String
  technology      String
  /// JSON-encoded string[] — who this ICP explicitly does NOT target.
  exclusions      String

  /// JSON-encoded array of {field, groundedInClaimIds: string[],
  /// status: EVIDENCED|ASSUMED, reasoning} — one entry per ICP field
  /// above (§3), mirroring dimensionGrounding's own shape (M3). A
  /// field with no real grounding is marked ASSUMED with an empty
  /// groundedInClaimIds array, never invented specificity.
  fieldGrounding String @map("field_grounding")

  generatedByAgentId String @map("generated_by_agent_id")
  generatedByAgent   Agent  @relation(fields: [generatedByAgentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  prospects           Prospect[]
  outreachExperiments OutreachExperiment[]

  @@index([opportunityId])
  @@map("icp_profiles")
}

/// A candidate person/organization matching an approved ICP (§4, §7-8)
/// — deliberately minimal fields, only what the brief calls "the
/// minimum information necessary." `publicContactChannel` is a public
/// business contact point only (a contact-form URL, a listed business
/// email, a public business-directory profile) — never a personal
/// email/phone or anything inferred rather than observed (§10).
model Prospect {
  id String @id @default(cuid())

  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  /// Nullable only for the SetNull-on-superseded-ICP case (§22) — every
  /// prospect is discovered against a real, approved ICP in practice.
  icpProfileId String?     @map("icp_profile_id")
  icpProfile   IcpProfile? @relation(fields: [icpProfileId], references: [id], onDelete: SetNull)

  organization         String
  role                 String
  publicContactChannel String @map("public_contact_channel")

  /// ResearchSource id — never caller-suppliable (§7, mirrors Signal.source).
  source       String
  sourceUrl    String   @map("source_url")
  discoveredAt DateTime @default(now()) @map("discovered_at")

  /// Set once prospectQualificationService runs; null beforehand — never a fabricated default (§5).
  qualificationStatus String? @map("qualification_status")
  icpFit              String? @map("icp_fit")
  reasonForMatch      String? @map("reason_for_match")
  /// JSON-encoded string[] — an honest list of what remains unknown (§5's own literal example: "actual pain level").
  unknowns            String  @default("[]")

  /// One of PROSPECT_STATUSES (prospect.types.ts) — pipeline position, distinct from qualificationStatus's assessment outcome.
  status String @default("DISCOVERED")

  discoveredByAgentId String @map("discovered_by_agent_id")
  discoveredByAgent   Agent  @relation(fields: [discoveredByAgentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  outreachMessages  OutreachMessage[]
  customerResponses CustomerResponse[]
  customerEvidence  CustomerEvidence[]

  @@index([opportunityId])
  @@index([icpProfileId])
  @@index([status])
  @@map("prospects")
}

/// A bounded, budgeted attempt to learn something specific from real
/// prospects (§11) — the first hard human gate in the M5 core loop.
/// Created PENDING_APPROVAL; only an explicit Human Owner action moves
/// it to ACTIVE. No Prospect may enter APPROVED_FOR_DRAFT under an
/// experiment that isn't ACTIVE.
model OutreachExperiment {
  id String @id @default(cuid())

  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  objective String

  /// The Claim this experiment is testing — Restrict: an experiment must always be able to say which claim it tested.
  claimId String @map("claim_id")
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Restrict)

  targetIcpProfileId String     @map("target_icp_profile_id")
  targetIcpProfile   IcpProfile @relation(fields: [targetIcpProfileId], references: [id], onDelete: Restrict)

  researchQuestion String @map("research_question")
  messageStrategy  String @map("message_strategy")

  prospectLimit   Int       @map("prospect_limit")
  timeWindowStart DateTime? @map("time_window_start")
  timeWindowEnd   DateTime? @map("time_window_end")

  /// Free text, founder-configurable — no fabricated statistical significance calculator (§11).
  successCriteria String @map("success_criteria")
  failureCriteria String @map("failure_criteria")

  /// The ceiling every Prospect discovered under this experiment inherits (§9). Never APPROVED by default.
  contactPolicy String @default("HUMAN_APPROVAL_REQUIRED") @map("contact_policy")

  status String @default("PENDING_APPROVAL")

  createdByIdentityId String   @map("created_by_identity_id")
  createdByIdentity   Identity @relation(fields: [createdByIdentityId], references: [id], onDelete: Restrict)

  /// Secondary actor annotation, plain string — mirrors ApprovalRequest.reviewedBy's own precedent (no FK relation).
  approvedByIdentityId String?   @map("approved_by_identity_id")
  approvedAt           DateTime? @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  outreachMessages       OutreachMessage[]
  customerDiscoveryMemos CustomerDiscoveryMemo[]

  @@index([opportunityId])
  @@index([status])
  @@map("outreach_experiments")
}

/// A single drafted message to a single, already-bound prospect (§12).
/// Immutable once created — no update method exists in
/// outreach-message.repository.ts beyond a status transition, the
/// structural enforcement of "approved message A cannot become
/// modified message B" (§13, §25.13). A revised draft is a new row
/// with a fresh id, requiring its own fresh approval.
model OutreachMessage {
  id String @id @default(cuid())

  experimentId String             @map("experiment_id")
  experiment   OutreachExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  prospectId String   @map("prospect_id")
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Restrict)

  /// Immutable — set once at draft time, never updated (§12).
  content   String
  reasoning String

  claimBeingTestedId      String @map("claim_being_tested_id")
  claimBeingTested        Claim  @relation(fields: [claimBeingTestedId], references: [id], onDelete: Restrict)
  expectedInformationGain Float  @map("expected_information_gain")

  status String @default("DRAFT")

  /// Set once approval is requested (§13); the exact ApprovalRequest a human decision binds to.
  approvalRequestId String?          @map("approval_request_id")
  approvalRequest   ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: SetNull)

  /// Record-keeping only — no code path in this system ever sends anything externally (§13).
  contactedAt           DateTime? @map("contacted_at")
  contactedByIdentityId String?   @map("contacted_by_identity_id")

  draftedByAgentId String @map("drafted_by_agent_id")
  draftedByAgent   Agent  @relation(fields: [draftedByAgentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customerResponses CustomerResponse[]

  @@index([experimentId])
  @@index([prospectId])
  @@index([status])
  @@map("outreach_messages")
}

/// A human-pasted record of what a prospect actually said (§14) — no
/// connector abstraction built for a single implementer. Immutable
/// rawContent, same provenance discipline as OutreachMessage.content.
model CustomerResponse {
  id String @id @default(cuid())

  outreachMessageId String          @map("outreach_message_id")
  outreachMessage   OutreachMessage @relation(fields: [outreachMessageId], references: [id], onDelete: Restrict)

  /// Denormalized from outreachMessage.prospectId — direct "all responses from this prospect" queries without a join (mirrors CustomerEvidence.prospectId's own reasoning).
  prospectId String   @map("prospect_id")
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Restrict)

  /// Immutable once recorded (§14).
  rawContent String @map("raw_content")

  /// One of RESPONSE_CLASSIFICATIONS; null until responseAnalystService runs.
  classification String?

  status String @default("RECEIVED")

  enteredByIdentityId String   @map("entered_by_identity_id")
  enteredByIdentity   Identity @relation(fields: [enteredByIdentityId], references: [id], onDelete: Restrict)

  recordedAt DateTime  @default(now()) @map("recorded_at")
  analyzedAt DateTime? @map("analyzed_at")

  customerEvidence CustomerEvidence[]

  @@index([outreachMessageId])
  @@index([prospectId])
  @@index([status])
  @@map("customer_responses")
}

/// Wraps one real M4 Evidence row (sourceType="CUSTOMER") with the
/// M5-specific structured fields a customer response actually needs
/// (§16-17) — append-only, no status (matches ClaimEvidence's own
/// append-only-no-status precedent). `signalType` is the safety-critical
/// dimension: only signal types CUSTOMER_SIGNAL_ELIGIBLE_CLAIM_TYPES
/// actually authorizes for a given claim type are ever offered to the
/// Evidence Validator as candidates for it (domain/customer-evidence/signal-routing.ts).
model CustomerEvidence {
  id String @id @default(cuid())

  responseId String           @map("response_id")
  response   CustomerResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  /// The real Evidence row this wraps — Restrict: must never be deleted out from under it (§22).
  evidenceId String   @map("evidence_id")
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  /// Denormalized from response.prospectId — direct organizationKey/independence lookups without a join chain (§18).
  prospectId String   @map("prospect_id")
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Restrict)

  /// One of CUSTOMER_SIGNAL_TYPES (customer-signal.types.ts).
  signalType       String  @map("signal_type")
  /// Only set when signalType="OBJECTION" — which claim type the objection is actually about (signal-routing.ts).
  relatedClaimType String? @map("related_claim_type")

  strength   String
  directness String

  extractedByAgentId String @map("extracted_by_agent_id")
  extractedByAgent   Agent  @relation(fields: [extractedByAgentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([responseId])
  @@index([evidenceId])
  @@index([prospectId])
  @@map("customer_evidence")
}

/// One experiment's findings (§22, brief §29) — mirrors InvestmentMemo's
/// own shape and append-only discipline, but a distinct entity: the
/// audience-moment (one experiment's findings) and field list
/// (prospects contacted, independent orgs, claims strengthened/
/// weakened) genuinely differ from an Investment Memo's (one
/// opportunity's overall go/no-go case). humanDecision/humanReason/
/// decidedAt/decidedByIdentityId are filled in by exactly one later
/// update, the same "starts undecided, completed by a single human
/// action" shape ApprovalRequest itself already uses.
model CustomerDiscoveryMemo {
  id String @id @default(cuid())

  opportunityId String      @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  experimentId String             @map("experiment_id")
  experiment   OutreachExperiment @relation(fields: [experimentId], references: [id], onDelete: Restrict)

  ceoRecommendationId String            @map("ceo_recommendation_id")
  ceoRecommendation   CeoRecommendation @relation(fields: [ceoRecommendationId], references: [id], onDelete: Restrict)

  chairmanReviewId String         @map("chairman_review_id")
  chairmanReview   ChairmanReview @relation(fields: [chairmanReviewId], references: [id], onDelete: Restrict)

  /// JSON-encoded full structured memo body (every brief §29-named section: prospects contacted, responses, independent orgs, problem/WTP/urgency/negative evidence, major objections, remaining uncertainty).
  content String

  /// MANDATORY, own columns (never buried in content JSON) — mirrors InvestmentMemo's own strongestArgumentAgainst/investmentThesis treatment.
  claimsStrengthened           String @map("claims_strengthened")
  claimsWeakened               String @map("claims_weakened")
  independentOrganizationCount Int    @map("independent_organization_count")
  responseCount                Int    @map("response_count")
  recommendation               String
  confidence                   Float

  /// One of CUSTOMER_DISCOVERY_HUMAN_DECISIONS; null until the Human Owner decides (§30).
  humanDecision       String?   @map("human_decision")
  humanReason         String?   @map("human_reason")
  decidedAt           DateTime? @map("decided_at")
  decidedByIdentityId String?   @map("decided_by_identity_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([opportunityId])
  @@index([experimentId])
  @@map("customer_discovery_memos")
}

// ---------------------------------------------------------------------------
// M6 — Customer Discovery Intelligence's successor: the SaaS Factory
// (docs/M6_ARCHITECTURE_PROPOSAL.md)
// ---------------------------------------------------------------------------

/// One build attempt at one opportunity (§3) — not a versioned family;
/// a genuinely new attempt after REJECTED/FAILED is a new Product row
/// referencing the same opportunityId. Starts PROPOSED; only an
/// explicit Human Owner action moves it to APPROVED (§23's first hard
/// gate) — nothing before that point touches a workspace or writes a
/// line of code.
model Product {
  id String @id @default(cuid())

  opportunityId String      @unique @map("opportunity_id")
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  status String @default("PROPOSED")

  /// Set once ARCHITECTING starts — the real, disposable, gitignored
  /// factory-workspaces/<product-id>/ directory (§10, §19). Never a
  /// subtree of VentureForge's own src/.
  workspacePath String? @map("workspace_path")

  /// Honestly labeled ESTIMATE, never fabricated actual spend (§28-29).
  estimatedDevelopmentCostUsd Float? @map("estimated_development_cost_usd")
  estimatedOperatingCostUsd   Float? @map("estimated_operating_cost_usd")

  /// JSON DeploymentPlan/RollbackPlan (§24-27) — produced once HUMAN_REVIEW
  /// is reached, never executed by any code path in this milestone.
  deploymentPlan String? @map("deployment_plan")
  rollbackPlan   String? @map("rollback_plan")

  createdByIdentityId String   @map("created_by_identity_id")
  createdByIdentity   Identity @relation(fields: [createdByIdentityId], references: [id], onDelete: Restrict)

  /// Secondary actor annotation, plain string — mirrors OutreachExperiment.approvedByIdentityId's own precedent.
  approvedByIdentityId String?   @map("approved_by_identity_id")
  approvedAt           DateTime? @map("approved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  productSpecs       ProductSpec[]
  mvpArchitectures   MvpArchitecture[]
  engineeringTasks   EngineeringTask[]
  productReviewMemos ProductReviewMemo[]

  @@index([status])
  @@map("products")
}

/// The Product Strategist's output (§5) — historized, like IcpProfile:
/// a REQUEST_CHANGES verdict produces a new row, never an edit, so the
/// full history of what was proposed stays queryable.
model ProductSpec {
  id String @id @default(cuid())

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name           String
  targetCustomer String @map("target_customer")
  coreProblem    String @map("core_problem")
  coreWorkflow   String @map("core_workflow")

  /// JSON-encoded full ProductSpecContent (thesis, coreJobToBeDone,
  /// proposedSolution, successMetric, mvpBoundary, knownRisks,
  /// unknowns, openQuestions — every brief §6 field not already its
  /// own column below).
  content String

  /// JSON-encoded string[], NOT NULL and enforced non-empty at the
  /// service layer (§4) — a spec with no stated non-goal is refused.
  nonGoals String @map("non_goals")

  /// JSON-encoded string[] — enforced non-empty (§5): every important
  /// assumption must cite a real claim/evidence id belonging to this
  /// opportunity, never trusted on the model's own say-so.
  groundedInClaimIds    String @map("grounded_in_claim_ids")
  groundedInEvidenceIds String @map("grounded_in_evidence_ids")

  generatedByAgentId String @map("generated_by_agent_id")
  generatedByAgent   Agent  @relation(fields: [generatedByAgentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  features         Feature[]
  mvpArchitectures MvpArchitecture[]

  @@index([productId])
  @@map("product_specs")
}

/// One prioritized feature (§6-7) — an explainable table, never a bare
/// LLM score. Only claimId is a real FK (Restrict — must always be
/// able to say which claim this feature tests); evidenceIds stays
/// JSON, mirroring CeoRecommendation.citedClaimIds's own precedent.
model Feature {
  id String @id @default(cuid())

  productSpecId String      @map("product_spec_id")
  productSpec   ProductSpec @relation(fields: [productSpecId], references: [id], onDelete: Cascade)

  description      String
  problemAddressed String @map("problem_addressed")

  claimId String @map("claim_id")
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Restrict)

  /// JSON-encoded string[] of Evidence ids.
  evidenceIds String @map("evidence_ids")

  expectedLearning String @map("expected_learning")

  customerValue      Float @map("customer_value")
  learningValue      Float @map("learning_value")
  implementationCost Float @map("implementation_cost")
  technicalRisk      Float @map("technical_risk")

  /// Deterministically computed by domain/product/feature-priority.ts — never asked of a model.
  score     Float
  /// One of FEATURE_PRIORITIES.
  priority  String
  reasoning String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productSpecId])
  @@index([claimId])
  @@map("features")
}

/// The MVP Architect's output (§8-9) — historized, one level below
/// ProductSpec (which spec version this design answers). MUST_HAVE/
/// SHOULD_HAVE/DEFERRED tagging and every justification string live
/// inside designJson (§8: every MUST_HAVE requires a non-empty
/// justification, enforced at the service layer).
model MvpArchitecture {
  id String @id @default(cuid())

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  productSpecId String      @map("product_spec_id")
  productSpec   ProductSpec @relation(fields: [productSpecId], references: [id], onDelete: Restrict)

  /// JSON-encoded ArchitectureDesign (frontend, backend, database,
  /// authentication, authorization, externalDependencies, apis,
  /// coreEntities, dataFlows, errorHandling, testingStrategy,
  /// securityStrategy, deploymentStrategy, ux — each component tagged
  /// MUST_HAVE|SHOULD_HAVE|DEFERRED with a justification string).
  designJson String @map("design_json")

  generatedByAgentId String @map("generated_by_agent_id")
  generatedByAgent   Agent  @relation(fields: [generatedByAgentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  engineeringTasks EngineeringTask[]

  @@index([productId])
  @@index([productSpecId])
  @@map("mvp_architectures")
}

/// One bounded, reviewable unit of engineering work (§11-13) — never
/// one BUILD_ENTIRE_MVP task. allowedFiles is the real, enforced
/// permission boundary (domain/workspace/workspace-path.ts), not a
/// database field alone.
model EngineeringTask {
  id String @id @default(cuid())

  mvpArchitectureId String          @map("mvp_architecture_id")
  mvpArchitecture   MvpArchitecture @relation(fields: [mvpArchitectureId], references: [id], onDelete: Cascade)

  /// Denormalized from mvpArchitecture.productId — mirrors CustomerResponse.prospectId's own precedent (direct "all tasks for this product" queries without a join).
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  title   String
  purpose String

  /// JSON-encoded string[] of other EngineeringTask ids — informational ordering, not an enforced FK constraint (mirrors citedClaimIds's own JSON-not-join-table precedent).
  dependsOnTaskIds String @map("depends_on_task_ids")

  /// JSON-encoded string[], relative to the product's own workspace root — the real containment boundary write_workspace_file enforces.
  allowedFiles String @map("allowed_files")

  /// JSON-encoded string[].
  acceptanceCriteria String @map("acceptance_criteria")
  testsRequired      String @map("tests_required")

  /// GREEN — the two tools this task's agent may use (write_workspace_file/run_workspace_command) are both GREEN by design (§1, §29).
  riskLevel String @default("GREEN") @map("risk_level")

  status       String @default("PENDING")
  attemptCount Int    @default(0) @map("attempt_count")

  /// Filled in once the Engineering Agent runs — JSON-encoded string[] of relative paths actually written.
  filesChanged          String? @map("files_changed")
  implementationSummary String? @map("implementation_summary")
  /// JSON-encoded string[].
  knownLimitations      String? @map("known_limitations")
  /// JSON-encoded DependencyRecord[] (§17) — empty array by default (zero-new-dependency policy).
  dependencyRecords     String  @default("[]") @map("dependency_records")

  /// The Integration Test stage's own real, mechanical result (§2's pipeline, §15's split from QA's judgment) — null until it runs.
  integrationTestPassed Boolean? @map("integration_test_passed")
  integrationTestOutput String?  @map("integration_test_output")

  assignedAgentId String @map("assigned_agent_id")
  assignedAgent   Agent  @relation(fields: [assignedAgentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  codeReviews     CodeReview[]
  qaReports       QaReport[]
  securityReviews SecurityReview[]

  @@index([mvpArchitectureId])
  @@index([productId])
  @@index([status])
  @@map("engineering_tasks")
}

/// Independent inspection of one EngineeringTask's changes (§14) —
/// never performed by the same agent that wrote the code (structural:
/// a distinct Agent row, no method lets the Engineering Agent mark its
/// own review passed).
model CodeReview {
  id String @id @default(cuid())

  engineeringTaskId String          @map("engineering_task_id")
  engineeringTask   EngineeringTask @relation(fields: [engineeringTaskId], references: [id], onDelete: Cascade)

  /// JSON-encoded {severity, category, file, detail}[].
  findings           String  @map("findings")
  /// Denormalized for cheap querying — true iff any finding is BLOCKER (domain/code-review/code-review.types.ts's hasBlockingFinding).
  hasBlockingFinding Boolean @map("has_blocking_finding")

  reasoning String

  reviewedByAgentId String @map("reviewed_by_agent_id")
  reviewedByAgent   Agent  @relation(fields: [reviewedByAgentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([engineeringTaskId])
  @@map("code_reviews")
}

/// QA's judgment output (§15) — attacks the product from the user's
/// perspective; identifies MISSING tests, never merely re-runs
/// existing ones (the Integration Test stage, on EngineeringTask
/// itself, is the mechanical "do the tests pass" fact).
model QaReport {
  id String @id @default(cuid())

  engineeringTaskId String          @map("engineering_task_id")
  engineeringTask   EngineeringTask @relation(fields: [engineeringTaskId], references: [id], onDelete: Cascade)

  /// One of QA_VERDICTS.
  verdict String

  /// JSON-encoded string[] — missing test cases, the brief's own explicit requirement.
  missingTests String @map("missing_tests")
  /// JSON-encoded string[] — other findings (happy path/empty state/boundary/etc. checked).
  findings     String

  reasoning String

  reviewedByAgentId String @map("reviewed_by_agent_id")
  reviewedByAgent   Agent  @relation(fields: [reviewedByAgentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([engineeringTaskId])
  @@map("qa_reports")
}

/// Security's verdict for one EngineeringTask's generated code (§16) —
/// combines deterministic static-scan factors with model judgment,
/// same discipline as evidenceValidatorService. Every finding carries
/// concrete evidence, never a bare verdict.
model SecurityReview {
  id String @id @default(cuid())

  engineeringTaskId String          @map("engineering_task_id")
  engineeringTask   EngineeringTask @relation(fields: [engineeringTaskId], references: [id], onDelete: Cascade)

  /// One of SECURITY_VERDICTS.
  verdict String

  /// JSON-encoded SecurityFinding[] ({category, file, detail, evidence}).
  findings String

  reasoning String

  reviewedByAgentId String @map("reviewed_by_agent_id")
  reviewedByAgent   Agent  @relation(fields: [reviewedByAgentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([engineeringTaskId])
  @@map("security_reviews")
}

/// The Human Owner's actual final M6 artifact (§23, brief §42) —
/// compiled deterministically from already-persisted data, zero new
/// model calls, mirroring InvestmentMemo/CustomerDiscoveryMemo's own
/// discipline exactly. humanDecision/humanReason/decidedAt/
/// decidedByIdentityId are filled in by exactly one later update.
model ProductReviewMemo {
  id String @id @default(cuid())

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  ceoRecommendationId String            @map("ceo_recommendation_id")
  ceoRecommendation   CeoRecommendation @relation(fields: [ceoRecommendationId], references: [id], onDelete: Restrict)

  chairmanReviewId String         @map("chairman_review_id")
  chairmanReview   ChairmanReview @relation(fields: [chairmanReviewId], references: [id], onDelete: Restrict)

  /// JSON-encoded full structured memo body (every brief §42-named section).
  content String

  recommendation String
  confidence     Float

  /// One of PRODUCT_REVIEW_HUMAN_DECISIONS; null until the Human Owner decides.
  humanDecision       String?   @map("human_decision")
  humanReason         String?   @map("human_reason")
  decidedAt           DateTime? @map("decided_at")
  decidedByIdentityId String?   @map("decided_by_identity_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_review_memos")
}
