# Copy to .env and adjust for local development.

# SQLite file used by Prisma in M1. See docs/DECISIONS.md for the
# rationale and the migration path to Postgres for production.
DATABASE_URL="file:./dev.db"

# HTTP port for the kernel API.
PORT=3000

# Comma-separated list of identities allowed to act as the Human Owner
# (approve/reject decisions, grant permissions). This is an allow-list,
# not authentication — see docs/SECURITY.md for why M1 ships without a
# login system and what that implies about deployment.
HUMAN_OWNER_IDS="founder"
