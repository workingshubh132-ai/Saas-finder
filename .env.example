# Copy to .env and adjust for local development.

# SQLite file used by Prisma. See docs/DECISIONS.md for the rationale
# and the migration path to Postgres for production.
DATABASE_URL="file:./dev.db"

# HTTP port for the kernel API.
PORT=3000

# --- M2: identity & authentication -----------------------------------
# There is no env-based allow-list anymore (M1 had HUMAN_OWNER_IDS;
# see docs/DECISIONS.md for why it was replaced). The first HUMAN
# identity is created by calling POST /api/identities once against a
# freshly migrated, empty database (bootstrap) — see docs/SECURITY.md.

# --- M2: model provider -------------------------------------------------
# "development" (default) never calls a real model — every ModelProvider
# call returns a clearly labeled, caller-supplied fixture. Safe to run
# anywhere, including this sandbox, with no credentials. Set to
# "anthropic" for a real deployment with a real key.
MODEL_PROVIDER_MODE="development"
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL="claude-3-5-haiku-20241022"

# --- M2/M3: research sources ---------------------------------------------
# "development" (default) never makes a network call — every
# registered source returns a clearly labeled fixture. Set to "live" to
# use the real, keyless research sources (Hacker News Algolia, Stack
# Exchange) in a deployment with outbound network access (this
# sandbox's proxy blocks at least hn.algolia.com — see docs/SOURCE_ADAPTERS.md).
RESEARCH_TOOL_MODE="development"
